import numpy as np from scipy.optimize import linprog def all\_conditionally\_rational\_p1(S1, X2, U1): """ Finds all pure strategies in S1 that are best responses to at least one belief (probability distribution) over Player 2's strategy set X2\. """ if not X2: return set() X2\_list = sorted(list(X2)) num\_vars = len(X2\_list) best\_responses = set() # Check LFP feasibility for each candidate strategy r in S1 for r in S1: A\_ub = [] b\_ub = [] for r\_prime in S1: if r\_prime == r: continue # EU(r') - EU(r) &lt;= 0 diff = [U1[r\_prime, c] - U1[r, c] for c in X2\_list] A\_ub.append(diff) b\_ub.append(0.0) # Objective is zero (pure feasibility problem) c\_obj = np.zeros(num\_vars) # Probability sum constraint: sum(p\_c) = 1 A\_eq = [np.ones(num\_vars)] b\_eq = [1.0] # Non-negativity bounds: p\_c &gt;= 0 bounds = [(0, 1)] \* num\_vars if len(A\_ub) == 0: best\_responses.add(r) else: res = linprog( c\_obj, A\_ub=A\_ub, b\_ub=b\_ub, A\_eq=A\_eq, b\_eq=b\_eq, bounds=bounds, method="highs", ) if res.success: best\_responses.add(r) return best\_responses def all\_conditionally\_rational\_p2(S2, X1, U2): """ Finds all pure strategies in S2 that are best responses to at least one belief (probability distribution) over Player 1's strategy set X1\. """ if not X1: return set() X1\_list = sorted(list(X1)) num\_vars = len(X1\_list) best\_responses = set() for c in S2: A\_ub = [] b\_ub = [] for c\_prime in S2: if c\_prime == c: continue # EU(c') - EU(c) &lt;= 0 diff = [U2[r, c\_prime] - U2[r, c] for r in X1\_list] A\_ub.append(diff) b\_ub.append(0.0) c\_obj = np.zeros(num\_vars) A\_eq = [np.ones(num\_vars)] b\_eq = [1.0] bounds = [(0, 1)] \* num\_vars if len(A\_ub) == 0: best\_responses.add(c) else: res = linprog( c\_obj, A\_ub=A\_ub, b\_ub=b\_ub, A\_eq=A\_eq, b\_eq=b\_eq, bounds=bounds, method="highs", ) if res.success: best\_responses.add(c) return best\_responses def min\_containing\_curb(seed\_strategy, player, U1, U2): """ Computes the smallest CURB set containing a given root/seed strategy. Runs in polynomial time O(n^2 \* LFP(n)). """ num\_p1, num\_p2 = U1.shape all\_S1 = set(range(num\_p1)) all\_S2 = set(range(num\_p2)) # Initialize with the root seed strategy if player == 1: X1 = {seed\_strategy} X2 = set() else: X1 = set() X2 = {seed\_strategy} converged = False while not converged: converged = True # 1\. Expand Player 2's set with best responses to Player 1's current set new\_X2 = all\_conditionally\_rational\_p2(all\_S2, X1, U2) if not new\_X2.issubset(X2): converged = False # CRITICAL: Union new strategies with existing ones X2 = X2.union(new\_X2) # 2\. Expand Player 1's set with best responses to Player 2's current set new\_X1 = all\_conditionally\_rational\_p1(all\_S1, X2, U1) if not new\_X1.issubset(X1): converged = False # CRITICAL: Union new strategies with existing ones X1 = X1.union(new\_X1) return X1, X2 def find\_all\_minimal\_curb\_sets(U1, U2): """ Finds all minimal CURB sets using min\_containing\_curb as a building block. """ num\_p1, num\_p2 = U1.shape candidate\_curbs = [] # Run min\_containing\_curb using each strategy as a seed for r in range(num\_p1): curb = min\_containing\_curb(r, player=1, U1=U1, U2=U2) if curb not in candidate\_curbs: candidate\_curbs.append(curb) for c in range(num\_p2): curb = min\_containing\_curb(c, player=2, U1=U1, U2=U2) if curb not in candidate\_curbs: candidate\_curbs.append(curb) # Filter candidates to retain only minimal CURB sets minimal\_curb\_sets = [] for X1, X2 in candidate\_curbs: is\_minimal = True for Y1, Y2 in candidate\_curbs: if (Y1, Y2) == (X1, X2): continue # If Y is strictly contained within X, X is not minimal if Y1.issubset(X1) and Y2.issubset(X2): is\_minimal = False break if is\_minimal and (X1, X2) not in minimal\_curb\_sets: minimal\_curb\_sets.append((X1, X2)) return minimal\_curb\_sets
